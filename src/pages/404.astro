---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { productions, productionStats } from '@data/productions';
import rehearsalPhoto from '../images/falls-rehearsal-recent.jpg';

// Production slugs are derived from titles by slugify(), so renaming a title
// silently moves its URL. Inbound links from press, Wikipedia, and old
// programs go stale without warning — so this page ships a lookup table and
// tries to recover the intended production rather than dead-ending.
const productionIndex = productions.map((production) => ({
  slug: production.slug,
  title: production.title,
  year: production.yearSpan,
  venue: production.venueAnchor,
}));

// Escaped so a title containing "</script>" could never break out of the tag.
const productionIndexJson = JSON.stringify(productionIndex).replace(/</g, '\\u003c');

const quickLinks = [
  { href: '/productions', label: 'Productions', note: `All ${productionStats.titleCount} titles, by decade` },
  { href: '/timeline',    label: 'Timeline',    note: `${productionStats.earliestYear}–${productionStats.latestYear}, year by year` },
  { href: '/credits',     label: 'Credits',     note: 'Full directing credits' },
  { href: '/press',       label: 'Press',       note: 'Coverage, reviews, and media assets' },
  { href: '/awards',      label: 'Awards',      note: 'Honors and recognition' },
  { href: '/contact',     label: 'Contact',     note: 'Booking, media, and archive inquiries' },
];
---

<BaseLayout
  title="Page Not Found — Robert Falls"
  description="That page could not be found. Browse the full Robert Falls production archive, career timeline, and credits."
  robots="noindex,follow"
>
  <section class="bg-brand-ink text-brand-cream relative overflow-hidden">
    <Image
      src={rehearsalPhoto}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      quality={68}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-[0.16] mix-blend-luminosity pointer-events-none"
    />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_rgba(138,19,36,0.28),_transparent_48%),linear-gradient(150deg,rgba(12,9,8,0.94),rgba(24,16,12,0.84))]"></div>
    <div class="grain-overlay"></div>
    <div class="relative pt-28 pb-16 md:pt-36 md:pb-20">
      <div class="section-container !py-0">
        <p class="section-eyebrow text-brand-gold">Error 404</p>
        <h1 class="font-display font-extrabold text-6xl md:text-8xl tracking-tight">
          Page Not Found
        </h1>
        <p class="mt-5 max-w-2xl text-brand-cream/75 leading-relaxed">
          The page you asked for isn't here. It may have moved, or the link that brought you
          may be out of date. The full archive is intact — start below.
        </p>
      </div>
    </div>
  </section>

  <section class="section-container">
    <!-- Recovered-match panel. Hidden until the script finds a candidate. -->
    <div id="did-you-mean" class="hidden mb-14" aria-live="polite">
      <p class="section-eyebrow">Closest Matches</p>
      <h2 class="font-display text-3xl md:text-4xl text-brand-ink mb-6">Did you mean&hellip;</h2>
      <ul id="did-you-mean-list" class="grid gap-3 sm:grid-cols-2"></ul>
    </div>

    <div class="flex items-end justify-between gap-4 flex-wrap mb-8">
      <div>
        <p class="section-eyebrow">Where to Go</p>
        <h2 class="section-heading">Browse the Archive</h2>
      </div>
      <div class="text-xs uppercase tracking-[0.16em] text-brand-ink/65 sm:text-right">
        {productionStats.titleCount} productions documented,
        <span class="whitespace-nowrap">{productionStats.earliestYear}&ndash;{productionStats.latestYear}</span>
      </div>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
      {quickLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="group block h-full border border-brand-ink/12 bg-white p-6 transition-colors hover:border-brand-oxblood/30"
          >
            <span class="font-display text-2xl text-brand-ink group-hover:text-brand-oxblood transition-colors">
              {link.label}
            </span>
            <span class="block text-sm text-brand-ink/65 mt-2 leading-snug">{link.note}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap gap-4">
      <a href="/productions" class="btn-primary">Browse All Productions</a>
      <a href="/" class="btn-outline">Return Home</a>
    </div>
  </section>

  <!-- Data island, not executable code — kept inline so Astro doesn't bundle it. -->
  <script is:inline type="application/json" id="production-index" set:html={productionIndexJson}></script>

  <script is:inline>
    (function () {
      var node = document.getElementById('production-index');
      var panel = document.getElementById('did-you-mean');
      var list = document.getElementById('did-you-mean-list');
      if (!node || !panel || !list) return;

      var entries;
      try {
        entries = JSON.parse(node.textContent || '[]');
      } catch (err) {
        return;
      }
      if (!entries.length) return;

      // Reduce the failed URL to comparable tokens: "/productions/King-Lear-2006/"
      // -> ["king", "lear", "2006"].
      function tokenize(value) {
        return value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, ' ')
          .trim()
          .split(' ')
          .filter(Boolean);
      }

      var path = decodeURIComponent(window.location.pathname);
      var attempted = path.replace(/^\/+|\/+$/g, '').split('/').pop() || '';
      var wanted = tokenize(attempted);
      if (!wanted.length) return;

      var wantedJoined = wanted.join('');

      var scored = entries
        .map(function (entry) {
          var slugTokens = tokenize(entry.slug);
          var slugJoined = slugTokens.join('');
          var score = 0;

          if (slugJoined === wantedJoined) {
            score = 1000;
          } else if (slugJoined.indexOf(wantedJoined) !== -1 || wantedJoined.indexOf(slugJoined) !== -1) {
            // One is contained in the other: "kinglear2006" vs "kinglear".
            score = 400 + Math.min(slugJoined.length, wantedJoined.length);
          }

          // Shared word count, weighted so rarer long words matter more than "the".
          var shared = 0;
          for (var i = 0; i < wanted.length; i++) {
            if (slugTokens.indexOf(wanted[i]) !== -1) shared += wanted[i].length > 3 ? 3 : 1;
          }
          score += shared * 20;

          return { entry: entry, score: score };
        })
        .filter(function (row) {
          return row.score >= 40;
        })
        .sort(function (a, b) {
          return b.score - a.score;
        })
        .slice(0, 4);

      if (!scored.length) return;

      scored.forEach(function (row) {
        var entry = row.entry;
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '/productions/' + entry.slug;
        a.className =
          'group flex items-baseline justify-between gap-4 border border-brand-ink/12 bg-white px-5 py-4 transition-colors hover:border-brand-oxblood/30';

        var title = document.createElement('span');
        title.className =
          'font-display text-xl text-brand-ink group-hover:text-brand-oxblood transition-colors leading-tight';
        title.textContent = entry.title;

        var meta = document.createElement('span');
        meta.className =
          'text-[11px] uppercase tracking-[0.14em] text-brand-ink/65 font-semibold shrink-0';
        meta.textContent = entry.year;

        a.appendChild(title);
        a.appendChild(meta);
        li.appendChild(a);
        list.appendChild(li);
      });

      panel.classList.remove('hidden');
    })();
  </script>
</BaseLayout>
